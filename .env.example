# ---------------------------------------------------------------------------
# Pothi Sahib / Gurbani Kosh - environment configuration
# Copy to .env and fill in. Never commit .env. See docs/deployment.md and docs/local-development.md.
# ---------------------------------------------------------------------------

# --- Database -----------------------------------------------------------------
# Owner/migrator connection. Migrations and the CLI use this.
#   Zero-setup development (PostgreSQL in-process via PGlite, persisted in a folder):
DATABASE_URL=pglite://./.data/kosh
#   Production / CI PostgreSQL (the docker-compose topology uses this form):
# DATABASE_URL=postgres://kosh_owner:change-me@localhost:5432/gurbani_kosh

# Dedicated per-service logins (production). When unset, each service uses DATABASE_URL and
# SET ROLE to the same database role, which requires DATABASE_URL to be a superuser/member login.
# PUBLIC_DATABASE_URL=postgres://kosh_public:change-me@localhost:5432/gurbani_kosh   # SELECT on public_api.* only
# APP_DATABASE_URL=postgres://kosh_app:change-me@localhost:5432/gurbani_kosh         # DML, bound by every trigger

# --- Secrets ------------------------------------------------------------------
# Encrypts TOTP secrets at rest (>= 16 chars; generate with: openssl rand -hex 32).
# Required for PostgreSQL; a fixed insecure development key is used for pglite:// when unset.
KOSH_MFA_KEY=change-me-change-me-change-me

# --- Storage ------------------------------------------------------------------
# Content-addressed object store for raw source artefacts (and later evidence).
KOSH_OBJECT_STORE_DIR=./.data/objects

# --- HTTP ---------------------------------------------------------------------
PUBLIC_API_PORT=8080
PUBLIC_API_HOST=0.0.0.0
PUBLIC_CORS_ORIGIN=*
ADMIN_API_PORT=8081
# The admin API binds to loopback by default; expose it only behind a reverse proxy or VPN.
ADMIN_API_HOST=127.0.0.1

# --- CLI ----------------------------------------------------------------------
# Set to false if the CLI's database login cannot SET ROLE (not a superuser / not a member).
# KOSH_SCOPE_ROLES=true
# Password for `kosh user create` when not run interactively (never pass passwords as arguments).
# KOSH_PASSWORD=
